{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*"],
  "exclude": ["src/preload/**/*.d.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@consoleri/core": ["./../../packages/core/src/index.ts"],
      "@consoleri/core/*": ["./../../packages/core/src/*"]
    }
  }
}
